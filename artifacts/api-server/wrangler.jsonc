{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-api-server",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Container roda a mesma imagem Docker do Express (ver Dockerfile).
  // max_instances: 1 e sem sleepAfter curto -> container fica sempre ativo,
  // preservando o comportamento atual de sessão (tokenStore em memória só
  // é perdido em deploy, não em ociosidade).
  "containers": [
    {
      "class_name": "ApiServerContainer",
      "image": "./Dockerfile",
      "name": "atlas-api-server",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "ApiServerContainer", "name": "API_CONTAINER" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ApiServerContainer"] }
  ],

  // Domínio final da API. Deixar comentado no primeiro deploy (publica só
  // sob *.workers.dev) até o smoke test passar - depois descomentar e
  // configurar o Custom Domain no dashboard da Cloudflare.
  // "routes": [{ "pattern": "api.atlas.niadcon.com.br/*", "custom_domain": true }]
}
